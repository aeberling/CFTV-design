layout: base.njk
title: "Iframe Test - Community Foundation of Teton Valley"
description: "Conference Room Booking embed test page."
permalink: /iframe-test/
---

{% include "utility-nav.njk" %}
{% include "header.njk" %}

<main id="main-content">
  <div style="width: 100%; margin: 0; padding: 0;">
    <iframe
      id="embed-iframe"
      src="https://legacy.cftetonvalley.org/operation-independence/?cftv_embed=1"
      width="100%"
      height="1200"
      frameborder="0"
      scrolling="yes"
      style="border: none; display: block; min-height: 1200px; overflow: auto;"
      title="Embedded Page"
    ></iframe>
  </div>
</main>

{% include "footer.njk" %}

<script>
  (function() {
    var params = new URLSearchParams(window.location.search);
    var page = params.get('page');
    if (page) {
      // Ensure leading slash
      if (page.charAt(0) !== '/') page = '/' + page;
      document.getElementById('embed-iframe').src = 'https://legacy.cftetonvalley.org' + page + '?cftv_embed=1';
    }
  })();
</script>
