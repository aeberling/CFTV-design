<style>
  .style-guide {
    max-width: 1200px;
    margin: 0 auto;
    padding: 60px 20px;
    font-family: 'Karla', sans-serif;
  }

  .style-guide h1 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 48px;
    font-weight: 700;
    color: #3d3454;
    margin-bottom: 10px;
  }

  .style-guide h2 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 32px;
    font-weight: 600;
    color: #3d3454;
    margin-bottom: 30px;
    padding-bottom: 10px;
    border-bottom: 2px solid #bdc8d2;
  }

  .style-guide h3 {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: 22px;
    font-weight: 600;
    color: #3d3454;
    margin-bottom: 16px;
    margin-top: 0;
  }

  .color-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .color-card {
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .color-swatch {
    height: 140px;
  }

  .color-info {
    padding: 16px;
    background: #fff;
  }

  .color-name {
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 4px;
    color: #1d292e;
  }

  .color-var {
    font-size: 12px;
    color: #415e68;
    font-family: monospace;
    margin-bottom: 2px;
  }

  .color-hex {
    font-size: 14px;
    color: #415e68;
    font-family: monospace;
  }

  .typography-sample {
    padding: 30px;
    background: #f8f7f6;
    margin-bottom: 16px;
  }

  .typography-label {
    font-size: 13px;
    color: #415e68;
    font-family: monospace;
    margin-bottom: 20px;
  }
</style>

