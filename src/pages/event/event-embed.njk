---
layout: base.njk
title: "Event - Community Foundation of Teton Valley"
description: "Event embed page."
permalink: /event/dynamic/
---

{% include "utility-nav.njk" %}
{% include "header.njk" %}

<main id="main-content">
  <div style="width: 100%; margin: 0; padding: 0;">
    <iframe
      id="event-iframe"
      src=""
      width="100%"
      height="1200"
      frameborder="0"
      scrolling="yes"
      style="border: none; display: block; min-height: 1200px; overflow: auto;"
      title="Event"
    ></iframe>
  </div>
</main>

<script>
  (function() {
    var path = window.location.pathname;
    var match = path.match(/^\/event\/([a-zA-Z0-9-]+)\/?$/);
    if (match) {
      var slug = match[1];
      var iframe = document.getElementById('event-iframe');
      iframe.src = 'https://legacy.cftetonvalley.org/event/' + slug + '/?cftv_embed=1';
      iframe.title = slug.replace(/-/g, ' ');
      document.title = slug.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }) + ' - Community Foundation of Teton Valley';
    }
  })();
</script>

