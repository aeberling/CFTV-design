      <div class="faq-accordion__list" id="youthPhilanthropyFaq">

        <div class="faq-accordion__item">
          <button class="faq-accordion__button" type="button" data-bs-toggle="collapse" data-bs-target="#yp-faq-1" aria-expanded="false" aria-controls="yp-faq-1">
