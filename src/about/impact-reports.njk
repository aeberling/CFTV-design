<main id="main-content">
  {% include "page-hero.njk" %}
  {% include "subpage-nav.njk" %}

  <!-- IMPLEMENTATION: content-split
       heading: "2025 Impact Report"
       content: "Our 2025 Impact Report highlights the grants awarded..." (189 chars)
       image: annual-report-cover.webp (--contain modifier, object-fit: contain)
       button: "Download PDF" -> #
       background: default (--color-dusk)
       modifier: none (image left, content right) + --contain image modifier
       notes: Image uses --contain modifier with --color-grey-bg inline background.
  -->
  <section class="content-split" id="current">
    <div class="content-split__image content-split__image--contain" style="background: var(--color-grey-bg);">
      <img src="/assets/images/about/annual-report-cover.webp" alt="2025 Community Foundation of Teton Valley impact report cover" loading="lazy">
    </div>
    <div class="content-split__content">
      <span class="content-split__eyebrow">Latest Report</span>
      <h2 class="content-split__heading">2025 Impact Report</h2>
      <p class="content-split__text">Our 2025 Impact Report highlights the grants awarded, programs supported, and the growing impact of community generosity across Teton Valley. See how your contributions are making a difference.</p>
      <div class="content-split__buttons">
        <a href="/assets/documents/impact-report-2025.pdf" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Download PDF <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: past-reports
       Simple archive list of downloadable past report PDFs.
       heading: "Past Reports" (h3 — follows the h2 of the report above)
       list: repeater of links, each = report label + PDF file
             - label: e.g. "2024 Impact Report"
             - file: PDF download (opens new tab, download arrow icon appended)
       Download arrow SVG is decorative (aria-hidden in WP render).
       WP BLOCK: core/list with linked items, OR core/file repeated.
                 No custom block — heading + list of file links.
  -->
  <section class="past-reports">
    <div class="container">
      <h3 class="past-reports__heading">Past Reports</h3>
      <ul class="past-reports__list">
        <li>
          <a href="/assets/documents/impact-report-2024.pdf" target="_blank" rel="noopener noreferrer">
            2024 Impact Report
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>


  <!-- IMPLEMENTATION: cta-banner
       heading: "Questions about our financials?"
       accent_word: "financials" (wrapped in span)
       content: "We're committed to transparency. As a tax-exempt nonprofit, our IRS Form 990s and our original tax-exemption application are available upon request. Contact us with any questions."
       button: "Contact Us" -> /contact/
       background: default (--color-dark-pine)
  -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__content">
        <h2 class="cta-banner__heading">Questions about our <span>financials</span>?</h2>
        <p class="cta-banner__text">We're committed to transparency. As a tax-exempt nonprofit, our IRS Form 990s and our original tax-exemption application are available upon request. Contact us with any questions.</p>
      </div>
      <div class="cta-banner__action">
        <a href="/contact/" class="theme_btn theme_btn_bg theme_btn--light">Contact Us <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</main>

