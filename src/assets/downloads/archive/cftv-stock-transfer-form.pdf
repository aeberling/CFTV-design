<div class="wp-block-kadence-column kadence-column6192_8ecc47-dd"><div class="kt-inside-inner-col">
<h1 class="wp-block-heading has-text-align-center has-text-color" style="color:#ffffff;font-size:clamp(42.068px, 2.629rem + ((1vw - 3.2px) * 2.963), 80px);line-height:1">Elevating lives through </h1>



<h2 class="wp-block-heading has-text-align-center has-text-color" style="color:#ffffff;margin-top:-30px;margin-bottom:40px;font-size:clamp(38.682px, 2.418rem + ((1vw - 3.2px) * 2.603), 72px);letter-spacing:-2px;line-height:1"><em> the power of generosity</em></h2>



<h6 class="wp-block-heading has-text-align-center has-text-color" style="color:#ffffff;margin-top:40px;margin-bottom:0px;font-size:clamp(15.747px, 0.984rem + ((1vw - 3.2px) * 0.645), 24px);font-style:normal;font-weight:300;letter-spacing:-0.5px;line-height:1.2"></h6>



<div style="height:66px" aria-hidden="true" class="wp-block-spacer"></div>



<div class="wp-block-outermost-icon-block items-justified-center"><div class="icon-container has-no-icon-fill-color" style="width:34px;transform:rotate(0deg) scaleX(-1) scaleY(1)"><svg id="Layer_1" xmlns="http://www.w3.org/2000/svg" title="arrow down icon" width="95" height="95" version="1.1" viewBox="0 0 95 95" aria-label="arrow down"><defs><style>
