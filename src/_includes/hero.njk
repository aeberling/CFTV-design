<!-- IMPLEMENTATION: hero-split
     LEFT PANEL (static):
       - h1 heading
       - description text
       - 3 button fields (title + URL each) — if a button field is empty, hide it
     RIGHT PANEL (seasonal slider):
       - Repeater field for slides (background image, heading, text, button title, button URL)
       - If any field in a slide is empty, hide that element
       - Slick slider with auto-rotate
     WP BLOCK: 3 button groups (title + url), repeater for right panel slides
-->
<section class="hero-split">
  <div class="hero-split__static">
    <h1 class="wow fadeInUp2 animated" data-wow-delay=".1s">Give local.<br>Create lasting impact.</h1>
    <p class="wow fadeInUp2 animated" data-wow-delay=".3s">Your Community Foundation connects generosity to the causes, nonprofits, and people who make Teton Valley thrive.</p>
    {# Buttons: up to 3 — each hidden if title/url not provided #}
    <div class="hero-split__buttons wow fadeInUp2 animated" data-wow-delay=".5s">
      <a href="https://godonate.akoyago.com/cftetonvalley/fundcatalog" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Give Now <span></span></a>
      <a href="/give/start-a-fund/" class="theme_btn theme_btn3">Create a Fund <span></span></a>
      <a href="/nonprofits/dates-deadlines/" class="theme_btn theme_btn3">Grant Dates & Deadlines <span></span></a>
    </div>
  </div>
  <div class="hero-split__right">
    {# Seasonal Slider: repeater field — each slide has image, heading, text, button #}
    <div class="hero-split__slider">
      {# Slide 1 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="Scott Pierson, Board Chair, presents a gift to the Community Foundation of Jackson Hole in gratitude for their support of Teton Valley" style="background-image: url('/assets/images/hero/cftv-independence-scott-pierson.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content">
          <h2>Stepping into<br>Independence</h2>
          <p>The Community Foundation of Teton Valley is proud to step forward as an independent organization.</p>
          <a href="/news-events/community-foundation-of-teton-valley-steps-into-independence/" class="theme_btn theme_btn_bg">Read More <span></span></a>
        </div>
      </div>
      {# Slide 2 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="Community members celebrating at the annual Tin Cup Challenge giving event" style="background-image: url('/assets/images/hero/community-grant-award-ceremony.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content">
          <h2>Tin Cup<br>Challenge</h2>
          <p>Double your impact during our annual giving event.</p>
          <a href="/give/" class="theme_btn theme_btn_bg">Learn More <span></span></a>
        </div>
      </div>
    </div>
  </div>
</section>
