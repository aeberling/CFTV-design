<!-- IMPLEMENTATION: hero-split
     LEFT PANEL (static):
       - h1 heading
       - description text
       - 3 button fields (title + URL each) — if a button field is empty, hide it
     RIGHT PANEL (seasonal slider):
       - Repeater field for slides (background image, heading, text, button title, button URL)
       - If any field in a slide is empty, hide that element
       - Slick slider with auto-rotate
     WP BLOCK: 3 button groups (title + url), repeater for right panel slides
-->
<section class="hero-split">
  <div class="hero-split__static">
    <h1 class="wow fadeInUp2 animated" data-wow-delay=".1s">Give local.<br>Create lasting impact.</h1>
    <p class="wow fadeInUp2 animated" data-wow-delay=".3s">Your Community Foundation connects generosity to the causes, nonprofits, and people who make Teton Valley thrive.</p>
    {# Buttons: up to 4 — each hidden if title/url not provided #}
    <div class="hero-split__buttons wow fadeInUp2 animated" data-wow-delay=".5s">
      <a href="https://godonate.akoyago.com/cftetonvalley/fundcatalog" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Give: To Funds <span aria-hidden="true"></span></a>
      <a href="/give/start-a-fund/" class="theme_btn theme_btn3">Create a Fund <span aria-hidden="true"></span></a>
      <a href="/nonprofits/dates-deadlines/" class="theme_btn theme_btn3">Grant Dates & Deadlines <span aria-hidden="true"></span></a>
    </div>
  </div>
  <div class="hero-split__right">
    {# Seasonal Slider: repeater field — each slide has image, heading, text, button #}
    <div class="hero-split__slider" data-hero-slider>
      {# Slide 1 #}
      <div class="hero-split__slide is-active">
        <div class="hero-split__image" role="img" aria-label="2026 Tin Cup Challenge results infographic showing a record $4,509,605 total raised for Teton Valley nonprofits" style="background-image: url('/assets/images/news/tin-cup-challenge-2026-results.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content hero-split__right-content--long">
          <h2>Record<br>Breaking Year</h2>
          <p>Tin Cup Challenge generates a record $4.5 Million for Teton Valley Nonprofits</p>
          <a href="/news-events/tin-cup-challenge-generates-record-4-5-million-for-teton-valley-nonprofits/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Slide 2 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="Sue Heffron, Executive Director of the Teton Valley Food Pantry, receiving the 2026 Dawn Banks Nonprofit Leadership Award" style="background-image: url('/assets/images/news/sue-heffron-dawn-banks-award-2026.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content hero-split__right-content--long">
          <h2>Leading<br>with Compassion</h2>
          <p>Sue Heffron of the Teton Valley Food Pantry receives the 2026 Dawn Banks Nonprofit Leadership Award.</p>
          <a href="/news-events/leading-with-compassion-sue-heffron-recognized-for-outstanding-nonprofit-leadership/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Slide 3 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="Runners and costumed participants crossing the start line at Tin Cup Challenge Event Day in Driggs City Park" style="background-image: url('/assets/images/news/tin-cup-2026-race-start.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content hero-split__right-content--long">
          <h2>Show Your<br>Tin Cup Spirit –<br>Run. Give. Celebrate.</h2>
          <p>Join us at Driggs City Park on Saturday, July 18!</p>
          <a href="/news-events/show-your-tin-cup-spirit-run-celebrate-give-2026/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Dot navigation #}
      <div class="hero-split__dots">
        <button class="hero-split__dot is-active" aria-label="Slide 1"></button>
        <button class="hero-split__dot" aria-label="Slide 2"></button>
        <button class="hero-split__dot" aria-label="Slide 3"></button>
      </div>
    </div>
  </div>
</section>
