<!-- IMPLEMENTATION: hero-split
     LEFT PANEL (static):
       - h1 heading
       - description text
       - 3 button fields (title + URL each) — if a button field is empty, hide it
     RIGHT PANEL (seasonal slider):
       - Repeater field for slides (background image, heading, text, button title, button URL)
       - If any field in a slide is empty, hide that element
       - Slick slider with auto-rotate
     WP BLOCK: 3 button groups (title + url), repeater for right panel slides
-->
<section class="hero-split">
  <div class="hero-split__static">
    <h1 class="wow fadeInUp2 animated" data-wow-delay=".1s">Give local.<br>Create lasting impact.</h1>
    <p class="wow fadeInUp2 animated" data-wow-delay=".3s">Your Community Foundation connects generosity to the causes, nonprofits, and people who make Teton Valley thrive.</p>
    {# Buttons: up to 4 — each hidden if title/url not provided #}
    <div class="hero-split__buttons wow fadeInUp2 animated" data-wow-delay=".5s">
      <a href="https://godonate.akoyago.com/cftetonvalley/fundcatalog" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Give: To Funds <span aria-hidden="true"></span></a>
      <a href="/give/start-a-fund/" class="theme_btn theme_btn3">Create a Fund <span aria-hidden="true"></span></a>
      <a href="/nonprofits/dates-deadlines/" class="theme_btn theme_btn3">Grant Dates & Deadlines <span aria-hidden="true"></span></a>
    </div>
  </div>
  <div class="hero-split__right">
    {# Seasonal Slider: repeater field — each slide has image, heading, text, button #}
    <div class="hero-split__slider" data-hero-slider>
      {# Slide 1 #}
      <div class="hero-split__slide is-active">
        <div class="hero-split__image" role="img" aria-label="A Tin Cup Challenge mascot beside a mailbox holding the 19th Annual Tin Cup Challenge mailer" style="background-image: url('/assets/images/news/19th-annual-tin-cup-challenge.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content">
          <h2>Tin Cup<br>Challenge 2026</h2>
          <p>The Tin Cup Challenge 2026 is now live!</p>
          <a href="/news-events/19th-annual-tin-cup-challenge-launches-june-12/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Slide 2 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="2026 Competitive Grant awardees gathered at the Teton Valley Welcome Center" style="background-image: url('/assets/images/hero/2026-competitive-grant-awards.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content">
          <h2>$85,000 Awarded in<br>Competitive Grants</h2>
          <p>17 local nonprofits received 2026 Competitive Grant awards, made possible by Tin Cup Challengers.</p>
          <a href="/news-events/community-foundation-awards-85000-in-competitive-grants-to-17-local-nonprofits/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Slide 3 #}
      <div class="hero-split__slide">
        <div class="hero-split__image" role="img" aria-label="Scott Pierson, Board Chair, presents a gift to the Community Foundation of Jackson Hole in gratitude for their support of Teton Valley" style="background-image: url('/assets/images/hero/cftv-independence-scott-pierson.webp');"></div>
        <div class="hero-split__teal"></div>
        <div class="hero-split__right-content">
          <h2>Stepping into<br>Independence</h2>
          <p>The Community Foundation of Teton Valley is proud to step forward as an independent organization.</p>
          <a href="/news-events/community-foundation-of-teton-valley-steps-into-independence/" class="theme_btn theme_btn_bg">Read More <span aria-hidden="true"></span></a>
        </div>
      </div>
      {# Dot navigation #}
      <div class="hero-split__dots">
        <button class="hero-split__dot is-active" aria-label="Slide 1"></button>
        <button class="hero-split__dot" aria-label="Slide 2"></button>
        <button class="hero-split__dot" aria-label="Slide 3"></button>
      </div>
    </div>
  </div>
</section>
