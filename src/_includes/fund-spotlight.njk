<!-- IMPLEMENTATION: fund-spotlight
     heading: "Create a Fund"
     left: Testimonial quote from fund holder
     right: Fund types scrollable list with arrows + CTA button
     fund-types: Donor-Advised, Scholarship, Memorial/Named, Agency, Designated, Affinity/Collaborative
-->
<section class="fund-spotlight pt-80 pb-80">
  <div class="container">
    <div class="section-title text-center mb-50 wow fadeInUp2 animated" data-wow-delay=".1s">
      <h2>Start a Fund</h2>
    </div>
    <div class="row">
      <div class="col-xl-6 col-lg-6 d-flex align-items-center wow fadeInUp2 animated" data-wow-delay=".1s">
        <div class="fund-testimonial">
          <div class="quote-icon">&ldquo;</div>
          <blockquote>{{ fundQuote | default("Placeholder testimonial from a fund holder about why they started a fund with CFTV and the impact it has had on the community they care about.") | safe }}</blockquote>
          <div class="attribution">{{ fundAttribution | default("&mdash; Fund Holder Name") | safe }}</div>
        </div>
      </div>
      <div class="col-xl-6 col-lg-6 wow fadeInUp2 animated" data-wow-delay=".3s">
        <div class="fund-types">
          <h4>Fund Types</h4>
          <div class="fund-type-item">
            <span>Donor-Advised Fund</span>
          </div>
          <a href="/funds-scholarships/scholarships/" class="fund-type-item">
            <span>Scholarship Fund</span>
          </a>
          <a href="/funds-scholarships/memorial-funds/" class="fund-type-item">
            <span>Memorial / Named Fund</span>
          </a>
          <div class="fund-type-item">
            <span>Agency Fund</span>
          </div>
          <a href="/funds-scholarships/memorial-funds/" class="fund-type-item">
            <span>Designated Fund</span>
          </a>
          <div class="fund-type-item">
            <span>Affinity / Collaborative Fund</span>
          </div>
          <div class="fund-cta-btn">
            <a href="/give/start-a-fund/" class="theme_btn theme_btn_bg">Start a Fund <span aria-hidden="true"></span></a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
