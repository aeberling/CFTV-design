<!-- IMPLEMENTATION: tcc-banner
     Gold promo banner under the hero (adapted from the Tin Cup Challenge site).
     LEFT: h2 heading + supporting paragraph (left-aligned)
     RIGHT: single CTA button grouped with the Tinny mascot image (transparent PNG)
     WP BLOCK: heading + body text + 1 button (title + url) + image field
-->
<section class="tcc-banner">
  <div class="container">
    <div class="tcc-banner__inner">
      <div class="tcc-banner__content">
        <h2 class="tcc-banner__heading wow fadeInUp2 animated" data-wow-delay=".1s">Tin Cup Challenge</h2>
        <p class="wow fadeInUp2 animated" data-wow-delay=".2s">Support causes that make Teton Valley thrive. Your donation is partially matched by Challengers, boosting your impact. Every gift, big or small, makes a difference in our community.</p>
      </div>
      <div class="tcc-banner__cta">
        <a href="https://www.tincupchallenge.org" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg wow fadeInUp2 animated" data-wow-delay=".35s">Give: Tin Cup Challenge <span aria-hidden="true"></span></a>
        <div class="tcc-banner__media wow fadeInRight animated" data-wow-delay=".35s">
          <img src="/assets/images/home/tinny-mascot.png" alt="Tinny, the Tin Cup Challenge mascot, running" width="900" height="740" loading="lazy">
        </div>
      </div>
    </div>
  </div>
</section>
