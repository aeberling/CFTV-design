        <h1 class="post-detail__title">Teton Valley Aquatics: Tin Cup Challenge</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50378.webp" alt="Teton Valley Aquatics: Tin Cup Challenge" loading="lazy">
