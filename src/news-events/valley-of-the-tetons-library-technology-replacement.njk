        <h1 class="post-detail__title">Valley of the Tetons Library Technology Replacement</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50850.webp" alt="Valley of the Tetons Library Technology Replacement" loading="lazy">
