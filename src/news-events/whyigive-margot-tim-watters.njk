        <h1 class="post-detail__title">#WhyIGive – Margot & Tim Watters</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49299.webp" alt="#WhyIGive – Margot & Tim Watters" loading="lazy">
