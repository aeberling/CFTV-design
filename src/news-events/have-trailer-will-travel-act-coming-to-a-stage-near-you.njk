        <h1 class="post-detail__title">Have Trailer, Will Travel – ACT coming to a stage near you</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50801.webp" alt="Have Trailer, Will Travel – ACT coming to a stage near you" loading="lazy">
