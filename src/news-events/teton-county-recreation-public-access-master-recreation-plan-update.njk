        <h1 class="post-detail__title">Teton County Recreation & Public Access Master Recreation Plan Update</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50808.webp" alt="Teton County Recreation & Public Access Master Recreation Plan Update" loading="lazy">
