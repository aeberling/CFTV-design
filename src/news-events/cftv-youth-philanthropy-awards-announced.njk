        <h1 class="post-detail__title">CFTV Youth Philanthropy Awards Announced</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/home/make-a-difference.webp" alt="CFTV Youth Philanthropy Awards Announced" loading="lazy">
