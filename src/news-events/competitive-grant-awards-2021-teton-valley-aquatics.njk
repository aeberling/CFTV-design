        <h1 class="post-detail__title">Competitive Grant Awards 2021: Teton Valley Aquatics</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49964.webp" alt="Competitive Grant Awards 2021: Teton Valley Aquatics" loading="lazy">
