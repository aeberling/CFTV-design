        <h1 class="post-detail__title">$12.7 Million Raised in 11 Years!</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/47291.webp" alt="$12.7 Million Raised in 11 Years!" loading="lazy">
