        <h1 class="post-detail__title">Teton Arts: Creating Minds Stay Spunky!</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49556.webp" alt="Teton Arts: Creating Minds Stay Spunky!" loading="lazy">
