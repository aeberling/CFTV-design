        <h1 class="post-detail__title">In Memoriam | Dawn Trent Banks</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49405.webp" alt="In Memoriam | Dawn Trent Banks" loading="lazy">
