        <h1 class="post-detail__title">Competitive Grant Awards 2021: Seniors West of the Tetons</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49961.webp" alt="Competitive Grant Awards 2021: Seniors West of the Tetons" loading="lazy">
