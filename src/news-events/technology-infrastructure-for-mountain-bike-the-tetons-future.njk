        <h1 class="post-detail__title">Technology Infrastructure for Mountain Bike the Teton's Future</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50329.webp" alt="Technology Infrastructure for Mountain Bike the Teton's Future" loading="lazy">
