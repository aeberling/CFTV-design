        <h1 class="post-detail__title">2020 Tin Cup Challenge Results!</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/49780.webp" alt="2020 Tin Cup Challenge Results!" loading="lazy">
        </div>

        <div class="post-detail__content">
