        <h1 class="post-detail__title">Tin Cup Challenge: Teton Valley Museum</h1>

        <div class="post-detail__featured-image">
          <img src="/assets/images/news/50864.webp" alt="Tin Cup Challenge: Teton Valley Museum" loading="lazy">
