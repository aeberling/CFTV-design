  -->
  <section class="content-split" id="workshops">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/nonprofit-workshop-session.webp" alt="Nonprofit leaders gathered around a conference table during a Community Foundation training workshop" loading="lazy">
    </div>
    <div class="content-split__content">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Workshops & Networking/Training</h2>
      <p class="content-split__text">Build your capacity with hands-on workshops, networking events, and training opportunities designed specifically for Teton Valley nonprofits. Connect with peers, learn best practices, and grow your organization's effectiveness.</p>
      <div class="content-split__buttons">
        <a href="/nonprofits/workshops/" class="theme_btn theme_btn_bg">View Workshops <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Nonprofit Resources"
       content: "Take advantage of shared resources..." (160 chars)
       image: tincupplaceholder.webp (5:4, object-fit: cover)
