  {% include "testimonial.njk" %}

  <!-- IMPLEMENTATION: quick-links
       eyebrow: "Quick Links"
       heading: "More for Nonprofits"
       cards: 3 (Tin Cup Registration, Agency Funds, Nonprofit Directory)
       card_1: "Tin Cup Registration" | tin-cup-challenge.webp (4:3) | #
       card_2: "Agency Funds" | scholarship.webp (4:3) | #
       card_3: "Nonprofit Directory" | make-a-difference.webp (4:3) | #
       background: --color-grey-bg
       anchor: enabled | id: "tcc" | label: "Tin Cup Registration"
       notes: Section uses id="tcc" for anchor. Individual cards also carry id="tcc" and id="agency" for deep-linking — these are separate from the section-level anchor.
  -->
  <section class="quick-links" id="tcc">
    <div class="container">
      <p class="quick-links__eyebrow">Quick Links</p>
      <h2 class="quick-links__heading">More for Nonprofits</h2>
      <div class="quick-links__grid">
        <a href="/about/programs/#tin-cup" class="quick-links__card" id="tcc">
          <div class="quick-links__card-image">
            <img src="/assets/images/home/tin-cup-challenge.webp" alt="Tin Cup Registration" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Tin Cup Registration</h3>
              <p class="quick-links__card-text">Register your nonprofit and amplify your fundraising.</p>
            </div>
          </div>
        </a>
        <a href="/give/start-a-fund/" class="quick-links__card" id="agency">
          <div class="quick-links__card-image">
            <img src="/assets/images/nonprofits/development-cycle-workshop.webp" alt="Workshop presenter explaining the nonprofit development cycle to attendees at the Community Foundation" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Agency Funds</h3>
              <p class="quick-links__card-text">Long-term endowed support for your nonprofit.</p>
            </div>
          </div>
        </a>
        <a href="/nonprofit-directory/" class="quick-links__card">
          <div class="quick-links__card-image">
            <img src="/assets/images/nonprofits/girl-with-puppy-community-event.webp" alt="Young girl holding a puppy at a Teton Valley nonprofit community event" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Nonprofit Directory</h3>
              <p class="quick-links__card-text">Connect with nonprofits serving Teton Valley.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: cta-banner
       heading: "Need help? We're here for you."
