       background: --color-dark-pine
       modifier: --reverse (image right, content left)
       anchor: enabled | id: "resources" | label: "Nonprofit Resources"
  -->
  <section class="content-split content-split--reverse" id="resources">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/tin-cup-race-day-community.webp" alt="Community members and nonprofits with tents and booths at the Tin Cup Race Day event in Driggs" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-dark-pine);">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Nonprofit Resources</h2>
      <p class="content-split__text">Take advantage of shared resources available to local nonprofits through the Community Foundation. Access conference rooms, equipment, job boards, and more.</p>
      <div class="content-split__buttons">
        <a href="/nonprofits/resources/" class="theme_btn theme_btn_bg">Explore Resources <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Apply for Grants"
       content: "Find open, upcoming, and rolling grant opportunities..." (162 chars)
       image: make-a-difference.webp (5:4, object-fit: cover)
       button: "View All Grants" -> #
       background: --color-cirrus
       modifier: none (image left, content right)
       notes: Eyebrow and heading use dark-purple/dark-teal overrides via inline style
       anchor: enabled | id: "grants" | label: "Apply for Grants"
  -->
  <section class="content-split" id="grants">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/grant-recipient-handshake.webp" alt="Community Foundation representative shaking hands with a grant recipient at an awards ceremony" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-cirrus);">
      <span class="content-split__eyebrow" style="color: var(--color-dusk);">Subpage</span>
      <h2 class="content-split__heading" style="color: var(--color-graphite);">Apply for Grants</h2>
      <p class="content-split__text" style="color: var(--color-graphite);">Find open, upcoming, and rolling grant opportunities for your nonprofit. Check eligibility and apply before deadlines close.</p>
      <div class="content-split__buttons">
        <a href="/nonprofits/apply-for-grants/" class="theme_btn theme_btn_bg">View All Grants <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Dates & Deadlines"
       content: "Stay on top of important dates..." (183 chars)
       image: scholarship.webp (5:4, object-fit: cover)
       button: "View Calendar" -> #
       background: --color-pine
       modifier: --reverse (image right, content left)
       notes: Includes bullet list (content-split__list) for grant cycle details
       anchor: enabled | id: "dates" | label: "Dates & Deadlines"
  -->
  <section class="content-split content-split--reverse" id="dates">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/canal-view-northside-trail.webp" alt="Scenic creek winding through fall aspens along the Northside Trail in Teton Valley" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-pine);">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Dates & Deadlines</h2>
      <p class="content-split__text">Stay on top of important dates — grant cycles, workshop schedules, and key deadlines all in one place. This calendar auto-feeds the homepage and Apply for Grants page.</p>
      <ul class="content-split__list">
        <li>Grant cycles (open / close / awards / reports)</li>
        <li>Competitive, Youth Philanthropy, TCC</li>
        <li>Associated workshop dates</li>
      </ul>
      <div class="content-split__buttons">
        <a href="/nonprofits/dates-deadlines/" class="theme_btn theme_btn_bg">View Calendar <span></span></a>
      </div>
    </div>
  </section>

