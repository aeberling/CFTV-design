---
layout: base.njk
title: "Nonprofits - Community Foundation of Teton Valley"
description: "Workshops, resources, and grants for Teton Valley nonprofits."
permalink: /nonprofits/
heroHeading: "For Nonprofits"
heroText: "The Community Foundation is your partner. Access grants, training, shared resources, and tools to strengthen your organization and amplify your impact in Teton Valley."
heroStyle: "color-diagonal"
subpageNavItems:
  - { id: "workshops", label: "Workshops & Training" }
  - { id: "resources", label: "Nonprofit Resources" }
  - { id: "dates", label: "Grant Dates & Deadlines" }
---
<!-- PAGE: nonprofits
     background: solid-white
     theme: light
     notes: Subpage with page-hero, subpage-nav, alternating content-splits, quick-links grid, and CTA banner
-->

{% include "utility-nav.njk" %}
{% include "header.njk" %}

<main id="main-content">
  {% include "page-hero.njk" %}
  {% include "subpage-nav.njk" %}

  <!-- IMPLEMENTATION: content-split
       heading: "Workshops & Networking/Training"
       content: "Build your capacity with hands-on workshops..." (234 chars)
       image: scholarship.webp (5:4, object-fit: cover)
       button: "View Workshops" -> #
       background: default (--color-dusk)
       modifier: none (image left, content right)
       anchor: enabled | id: "workshops" | label: "Workshops & Training"
  -->
  <section class="content-split" id="workshops">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/nonprofit-workshop-session.webp" alt="Nonprofit leaders gathered around a conference table during a Community Foundation training workshop" loading="lazy">
    </div>
    <div class="content-split__content">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Workshops & Networking/Training</h2>
      <p class="content-split__text">Build your capacity with hands-on workshops, networking events, and training opportunities designed specifically for Teton Valley nonprofits. Connect with peers, learn best practices, and grow your organization's effectiveness.</p>
      <div class="content-split__buttons">
        <a href="/nonprofits/workshops/" class="theme_btn theme_btn_bg">View Workshops <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Nonprofit Resources"
       content: "Take advantage of shared resources..." (160 chars)
       image: tincupplaceholder.webp (5:4, object-fit: cover)
       button: "Explore Resources" -> #
       background: --color-dark-pine
       modifier: --reverse (image right, content left)
       anchor: enabled | id: "resources" | label: "Nonprofit Resources"
  -->
  <section class="content-split content-split--reverse" id="resources">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/nonprofit-resources.webp" alt="Nonprofit resources and community support in Teton Valley" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-dark-pine);">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Nonprofit Resources</h2>
      <p class="content-split__text">Take advantage of shared resources available to local nonprofits through the Community Foundation. Access conference rooms, equipment, job boards, and more.</p>
      <div class="content-split__buttons">
        <a href="/nonprofits/resources/" class="theme_btn theme_btn_bg">Explore Resources <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Grant Dates & Deadlines"
       content: "Stay on top of important dates..." (183 chars)
       image: scholarship.webp (5:4, object-fit: cover)
       button: "View Calendar" -> #
       background: --color-pine
       modifier: --reverse (image right, content left)
       notes: Includes bullet list (content-split__list) for grant cycle details
       anchor: enabled | id: "dates" | label: "Dates & Deadlines"
  -->
  <section class="content-split" id="dates">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/nonprofits/grant-recipient-handshake.webp" alt="Community Foundation representative shaking hands with a grant recipient at an awards ceremony" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-pine);">
      <span class="content-split__eyebrow">Subpage</span>
      <h2 class="content-split__heading">Grant Dates & Deadlines</h2>
      <p class="content-split__text">Stay on top of important dates — grant cycles, workshop schedules, and key deadlines all in one place.</p>
      <ul class="content-split__list">
        <li>Grant cycles (open / close / awards / reports)</li>
        <li>Competitive, Youth Philanthropy, TCC</li>
        <li>Associated workshop dates</li>
      </ul>
      <div class="content-split__buttons">
        <a href="/nonprofits/dates-deadlines/" class="theme_btn theme_btn_bg">View Calendar <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  {% set testimonialQuote = "In addition to saving nonprofits thousands in rental fees, the Foundation's shared resources are practically and environmentally sustainable for local organizations." %}
  {% set testimonialAttribution = "&mdash; Molly Nash, Executive Director<br>Teton Valley Community Recycling" %}
  {% include "testimonial.njk" %}

  <!-- IMPLEMENTATION: quick-links
       eyebrow: "Quick Links"
       heading: "More for Nonprofits"
       cards: 2 (Tin Cup Grant Program, Nonprofit Directory)
       background: --color-grey-bg
  -->
  <section class="quick-links">
    <div class="container">
      <p class="quick-links__eyebrow">Quick Links</p>
      <h2 class="quick-links__heading">More for Nonprofits</h2>
      <div class="quick-links__grid">
        <a href="/about/programs/#tin-cup" class="quick-links__card">
          <div class="quick-links__card-image">
            <img src="/assets/images/nonprofits/tincup-registration.webp" alt="Tin Cup Challenge registration and nonprofit event" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Tin Cup Grant Program</h3>
              <p class="quick-links__card-text">Apply for your nonprofit and amplify your fundraising.</p>
            </div>
          </div>
        </a>
        <div class="quick-links__card">
          <div class="quick-links__card-image">
            <img src="/assets/images/nonprofits/agency-fund-event.webp" alt="Tin Cup Challenge event supporting agency funds" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Agency Funds</h3>
              <p class="quick-links__card-text">Long-term endowed support for your nonprofit.</p>
            </div>
          </div>
        </div>
        <a href="/nonprofit-directory/" class="quick-links__card">
          <div class="quick-links__card-image">
            <img src="/assets/images/nonprofits/girl-with-puppy-community-event.webp" alt="Young girl holding a puppy at a Teton Valley nonprofit community event" loading="lazy">
          </div>
          <div class="quick-links__card-bottom">
            <div>
              <h3 class="quick-links__card-title">Nonprofit Directory</h3>
              <p class="quick-links__card-text">Connect with nonprofits serving Teton Valley.</p>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: cta-banner
       heading: "Need help? We're here for you."
       accent_word: "We're here" (wrapped in span)
       content: "Contact the Community Foundation to learn how we can support your nonprofit's mission."
       button: "Contact Us" -> /contact/
       background: default (--color-dark-pine)
  -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__content">
        <h2 class="cta-banner__heading">Need help? <span>We're here</span> for you.</h2>
        <p class="cta-banner__text">Contact the Community Foundation to learn how we can support your nonprofit's mission.</p>
      </div>
      <div class="cta-banner__action">
        <a href="/contact/" class="theme_btn theme_btn_bg theme_btn--light">Contact Us <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</main>

