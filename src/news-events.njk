---
layout: base.njk
title: "News & Events - Community Foundation of Teton Valley"
description: "Stay up to date with the latest news, announcements, and upcoming events from the Community Foundation of Teton Valley."
permalink: /news-events/
heroHeading: "News & Events"
heroText: "Stay connected with the latest from the Community Foundation — grant announcements, community stories, upcoming events, and more."
heroImage: "/assets/images/give/tin-cup-event-crowd.webp"
subpageNavItems:
  - { id: "news", label: "News" }
  - { id: "events", label: "Events" }
  - { id: "community-calendar", label: "Community Calendar" }
---
<!-- PAGE: news-events
     background: solid-white
     theme: light
     notes: Combined News & Events listing page. In WordPress, News = Posts (category-based), Events = Custom Post Type or The Events Calendar plugin. Both query into a single page with tab-style inner nav.
-->

{% include "utility-nav.njk" %}
{% include "header.njk" %}

<main id="main-content">
  {% include "page-hero.njk" %}
  {% include "subpage-nav.njk" %}

  <!-- IMPLEMENTATION: post-grid (News)
       wordpress_query: WP_Query for Posts (category != 'events'), orderby date DESC, posts_per_page 6
       card_fields: featured_image, category (tag), title, excerpt, date
       pagination: Show More button (JS reveals 6 at a time), WordPress AJAX in production
       background: white
       anchor: enabled | id: "news" | label: "News"
  -->
  <section class="post-grid" id="news">
    <div class="container">
      <div class="post-grid__header">
        <h2 class="post-grid__heading">Latest News</h2>
        <p class="post-grid__text">Grant announcements, community stories, and foundation updates.</p>
      </div>
      <div class="post-grid__cards" id="news-card-list">
        {% for post in collections.newsPosts %}
        <a href="{{ post.url }}" class="post-card" aria-label="{{ post.data.title | replace(' - Community Foundation of Teton Valley', '') }}">
          <div class="post-card__image">
            <img src="{{ post.data.newsImage }}" alt="" loading="lazy">
          </div>
          <div class="post-card__body">
            <span class="post-card__tag">{{ post.data.newsTag }}</span>
            <h3 class="post-card__title">{{ post.data.title | replace(' - Community Foundation of Teton Valley', '') }}</h3>
            <p class="post-card__excerpt">{{ post.data.newsExcerpt }}</p>
            <span class="post-card__date">{{ post.data.date | formatDate }}</span>
          </div>
        </a>
        {% endfor %}
      </div>
      <div class="post-grid__status sr-only" aria-live="polite"></div>
      <div class="post-grid__action">
        <button class="theme_btn theme_btn_bg post-grid__show-more" aria-expanded="false" aria-controls="news-card-list">Show More <span aria-hidden="true"></span></button>
      </div>
    </div>
  </section>

  <section class="post-grid post-grid--alt" id="events">
    <div class="container">
      <div class="post-grid__header">
        <h2 class="post-grid__heading">Upcoming Events</h2>
        <p class="post-grid__text">Workshops, community gatherings, and foundation events.</p>
      </div>
      <div class="post-grid__action">
        <a href="https://cftetonvalley.org/events/" target="_blank" rel="noopener" class="theme_btn theme_btn_bg">View Upcoming Events <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: community-calendar
       heading: "Community Calendar"
       content: Embedded iframe from Welcome Teton Valley
       background: white
       anchor: enabled | id: "community-calendar" | label: "Community Calendar"
  -->
  <section class="community-calendar" id="community-calendar">
    <div class="container">
      <div class="community-calendar__header">
        <h2 class="community-calendar__heading">Community Calendar</h2>
        <p class="community-calendar__text">Explore events happening across Teton Valley.</p>
      </div>
      <div class="community-calendar__embed">
        <iframe
          src="https://welcometetonvalley.org/events/"
          title="Teton Valley Community Calendar"
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: cta-banner
       heading: "Stay in the loop"
       accent_word: "in the loop" (wrapped in span)
       content: "Subscribe to our newsletter for grant announcements, event invites, and community stories."
       button: "Subscribe" -> /subscribe/
       background: default (--color-dark-pine)
  -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__content">
        <h2 class="cta-banner__heading">Stay <span>in the loop</span></h2>
        <p class="cta-banner__text">Subscribe to our newsletter for grant announcements, event invites, and community stories.</p>
      </div>
      <div class="cta-banner__action">
        <a href="/get-involved/subscribe/" class="theme_btn theme_btn_bg theme_btn--light">Subscribe <span aria-hidden="true"></span></a>
      </div>
    </div>
  </section>
</main>

{% include "footer.njk" %}
