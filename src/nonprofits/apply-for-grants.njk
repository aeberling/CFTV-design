  <!-- IMPLEMENTATION: content-split
       heading: "Open Grants"
       content: "The following grant programs are currently accepting applications..." (186 chars)
       image: funds/grants-awards-ceremony.webp (5:4, object-fit: cover)
       button: "Apply Now" -> #
       background: default (--color-dusk)
       modifier: none (image left, content right)
       notes: Includes grant-status-grid component showing open/upcoming/closed/rolling status
  -->
  <section class="content-split" id="open">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/funds/grants-awards-ceremony.webp" alt="Teton Valley nonprofit leaders at the Community Foundation competitive grants awards ceremony" loading="lazy">
    </div>
    <div class="content-split__content">
      <span class="content-split__eyebrow">Now Accepting Applications</span>
      <h2 class="content-split__heading">Open Grants</h2>
      <p class="content-split__text">The following grant programs are currently accepting applications. Check eligibility requirements and apply before deadlines close.</p>
      <ul class="content-split__list">
        <li><strong>Competitive Grants</strong> — Open</li>
        <li><strong>Tin Cup Challenge</strong> — Upcoming</li>
        <li><strong>Youth Philanthropy</strong> — Closed</li>
        <li><strong>Opportunity Fund</strong> — Rolling</li>
      </ul>
      <div class="content-split__buttons">
        <a href="/assets/documents/2026-grant-application-sample.pdf" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Apply Now <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Competitive Grants"
       content: "Each year, the Community Foundation awards Competitive Grants to support organizations addressing important community needs..." (248 chars)
       image: funds/trails-pathways-grant.webp (5:4, object-fit: cover)
       button: "View Competitive Grants" -> /about/programs/#competitive-grants
       background: --color-dark-pine
       modifier: --reverse (image right, content left)
  -->
  <section class="content-split content-split--reverse" id="upcoming">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/funds/competitive-grants.webp" alt="Competitive Grants funding local nonprofit impact in Teton Valley" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-dark-pine);">
      <span class="content-split__eyebrow">Annual Program</span>
      <h2 class="content-split__heading">Competitive Grants</h2>
      <p class="content-split__text">Each year, the Community Foundation awards Competitive Grants to support organizations addressing important community needs in Teton Valley. Funding decisions are made by a volunteer Grants Committee of dedicated community members with diverse interests and experience.</p>
      <ul class="content-split__list">
        <li>Application opens January — due mid-February</li>
        <li>Awards announced in April</li>
        <li>Funded by Tin Cup Challengers, individual donors, and endowed funds</li>
      </ul>
      <div class="content-split__buttons">
        <a href="/about/programs/#competitive-grants" class="theme_btn theme_btn_bg">View Program Details <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Opportunity Fund"
       content: "A long-term fund to facilitate collective impact and address critical emergent needs..." (163 chars)
       image: home/make-a-difference.webp (5:4, object-fit: cover)
       button: "Inquire" -> /contact/
       background: --color-graphite
       modifier: none (image left, content right)
  -->
  <section class="content-split" id="rolling">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/home/make-a-difference.webp" alt="Community Foundation supporting Teton Valley nonprofits through the Opportunity Fund" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-graphite);">
      <span class="content-split__eyebrow">Year-Round</span>
      <h2 class="content-split__heading">Opportunity Fund</h2>
      <p class="content-split__text">A long-term fund to facilitate collective impact and address critical emergent needs in Teton Valley. Rolling applications are accepted year-round for nonprofits facing unexpected challenges.</p>
      <div class="content-split__buttons">
        <a href="/contact/" class="theme_btn theme_btn_bg">Inquire <span></span></a>
      </div>
    </div>
  </section>

  <!-- IMPLEMENTATION: content-split
       heading: "Eligibility"
       content: "To be eligible for funding, an organization must be a 501(c)(3)..." (218 chars)
       image: hero/scholarship.webp (5:4, object-fit: cover)
       button: none
       background: --color-cirrus
       modifier: --reverse (image right, content left)
       notes: Eyebrow uses --color-dusk, heading/text use --color-graphite for contrast on pink bg. Includes bullet list for eligibility requirements.
  -->
  <section class="content-split content-split--reverse" id="eligibility">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/hero/scholarship.webp" alt="Teton Valley nonprofit eligible for Community Foundation grant funding" loading="lazy">
    </div>
    <div class="content-split__content content-split__content--light-bg">
      <span class="content-split__eyebrow">Requirements</span>
      <h2 class="content-split__heading">Eligibility</h2>
      <p class="content-split__text">To be eligible for funding, an organization must meet the following requirements:</p>
      <ul class="content-split__list">
        <li>501(c)(3) nonprofit, government entity, or IRS-recognized charitable organization serving Teton Valley, ID and/or Alta, WY</li>
        <li>Grant funds must be used exclusively in Teton Valley, ID & Alta, WY</li>
        <li>Funds may not be used for debt retirement or religious/political activities</li>
        <li>Grant funds may not be used for completed projects</li>
      </ul>
    </div>
  </section>

