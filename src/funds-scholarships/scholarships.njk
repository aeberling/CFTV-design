  <section class="content-split content-split--reverse" id="blake-chapman">
    <div class="content-split__image content-split__image--center">
      <img src="/assets/images/funds/blake-chapman-scholarship.webp" alt="Blake Chapman Aviation Scholarship student learning to fly at Teton Aviation in Driggs Idaho" loading="lazy">
    </div>
    <div class="content-split__content" style="background: var(--color-dark-pine);">
      <span class="content-split__eyebrow">Current Scholarship</span>
      <h2 class="content-split__heading">Blake Chapman Aviation Scholarship</h2>
      <p class="content-split__text">The Blake Chapman Aviation Scholarship was created by a group of individuals who wanted to give students in the Tetons, the opportunity to learn how to fly. This scholarship provides up to $12,000 towards the cost of a Private Pilot Certificate — including instruction, flight time, and books.</p>
      <ul class="content-split__list">
        <li>Open to Teton area students (ID & WY), high school juniors or seniors, age 17+</li>
        <li>Must demonstrate good academic standing and community involvement</li>
        <li>Available June through end of August, 4–5 days a week for training</li>
      </ul>
      <div class="content-split__buttons">
        <a href="/assets/documents/blake-chapman-scholarship-application-2026.docx" target="_blank" rel="noopener noreferrer" class="theme_btn theme_btn_bg">Scholarship Application <span aria-hidden="true"></span></a>
      </div>
      <p class="content-split__note">Opens annually in early January</p>
    </div>
  </section>

  {% set testimonialQuote = "Aviation opened doors for me that changed my life. I hold a scholarship fund with the Community Foundation of Teton Valley to open those same doors for young people who dream of flying but need a little lift to get off the ground." %}
